# Copy this file to .env.local and adjust for your environment.
# Only VITE_ prefixed variables are exposed to the browser bundle.

# Base path of the single VCTN FastAPI backend
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target (used by vite.config.ts)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
