# =============================================================================
# VCTN backend configuration - copy this file to `.env` and fill in real values.
#
# This is the ONLY place backend configuration lives. Every value below maps to
# a field on `app/core/config.py::Settings`. Never hard code configuration in
# Python source, and never commit a real `.env` file.
#
# Precedence: real environment variables override values from `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=vctn-api
APP_VERSION=0.1.0
# development | testing | staging | production
APP_ENV=development
APP_DEBUG=false
# Business API prefix. System probes (/health, /ready, /version) stay at root.
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# PostgreSQL - fill in these fields (a URL is NOT required)
# Leave DB_HOST empty to disable database access.
# -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional escape hatch: a complete URL that overrides the fields above.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# -----------------------------------------------------------------------------
# SQLAlchemy engine
# -----------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# -1 disables connection recycling (SQLAlchemy default).
DB_POOL_RECYCLE_SECONDS=-1
DB_POOL_PRE_PING=true
# Empty / unset means "follow APP_DEBUG".
DB_ECHO_SQL=

# -----------------------------------------------------------------------------
# Redis - fill in these fields (a URL is NOT required)
# Leave REDIS_HOST empty to disable Redis access.
# REDIS_USERNAME is only needed for Redis 6+ ACL users.
# -----------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
# Optional escape hatch: a complete URL that overrides the fields above.
# REDIS_URL=redis://HOST:6379/0
REDIS_URL=

# -----------------------------------------------------------------------------
# Redis client
# -----------------------------------------------------------------------------
REDIS_ENCODING=utf-8
REDIS_DECODE_RESPONSES=true
# Empty / unset keeps the redis library default.
REDIS_MAX_CONNECTIONS=
REDIS_SOCKET_TIMEOUT_SECONDS=

# -----------------------------------------------------------------------------
# HTTP / CORS
# The wildcard origin "*" is rejected by configuration validation.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=X-Trace-ID,X-Request-ID

# -----------------------------------------------------------------------------
# Tracing
# -----------------------------------------------------------------------------
TRACE_ID_HEADER=X-Trace-ID
REQUEST_ID_HEADER=X-Request-ID
TRACE_ID_MAX_LENGTH=128

# -----------------------------------------------------------------------------
# Logging
# LOG_LEVEL empty means "derive from APP_DEBUG" (DEBUG when true, else INFO).
# LOG_DATE_FORMAT empty means "use the logging module default".
# -----------------------------------------------------------------------------
LOG_LEVEL=
LOG_FORMAT=%(asctime)s %(levelname)-8s %(name)s [trace_id=%(trace_id)s] %(message)s
LOG_DATE_FORMAT=
# stdout | stderr
LOG_STREAM=stdout
