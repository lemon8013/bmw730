# Copy this file to .env and fill in real values locally.
# Never commit a real .env file and never hard code credentials.

APP_NAME=vctn-api
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false

# PostgreSQL (async driver)
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Redis
# REDIS_URL=redis://HOST:6379/0
REDIS_URL=

# Business API prefix
API_PREFIX=/api/v1

# Comma separated allow-list. The wildcard origin "*" is rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
