# =============================================================================
# VCTN backend configuration - copy this file to `.env` and fill in real values.
#
# This is the ONLY place backend configuration lives. Every value below maps to
# a field on `app/core/config.py::Settings`. Never hard code configuration in
# Python source, and never commit a real `.env` file.
#
# Precedence: real environment variables override values from `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=vctn-api
APP_VERSION=0.1.0
# development | testing | staging | production
APP_ENV=development
APP_DEBUG=false
# Business API prefix. System probes (/health, /ready, /version) stay at root.
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# PostgreSQL - fill in these fields (a URL is NOT required)
# Leave DB_HOST empty to disable database access.
# -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional escape hatch: a complete URL that overrides the fields above.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# -----------------------------------------------------------------------------
# SQLAlchemy engine
# -----------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# -1 disables connection recycling (SQLAlchemy default).
DB_POOL_RECYCLE_SECONDS=-1
DB_POOL_PRE_PING=true
# Empty / unset means "follow APP_DEBUG".
DB_ECHO_SQL=

# -----------------------------------------------------------------------------
# Redis - fill in these fields (a URL is NOT required)
# Leave REDIS_HOST empty to disable Redis access.
# REDIS_USERNAME is only needed for Redis 6+ ACL users.
# -----------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
# Optional escape hatch: a complete URL that overrides the fields above.
# REDIS_URL=redis://HOST:6379/0
REDIS_URL=

# -----------------------------------------------------------------------------
# Redis client
# -----------------------------------------------------------------------------
REDIS_ENCODING=utf-8
REDIS_DECODE_RESPONSES=true
# Empty / unset keeps the redis library default.
REDIS_MAX_CONNECTIONS=
REDIS_SOCKET_TIMEOUT_SECONDS=

# -----------------------------------------------------------------------------
# Snowflake ID
# DD-14 is not frozen: the layout below is the minimal runnable default and is
# exposed here so it can be changed without touching code.
# -----------------------------------------------------------------------------
SNOWFLAKE_EPOCH_MS=1735689600000
SNOWFLAKE_NODE_ID=1
SNOWFLAKE_NODE_BITS=10
SNOWFLAKE_SEQUENCE_BITS=12

# -----------------------------------------------------------------------------
# Authentication
# Token lifetime is not frozen. AUTH_JWT_SECRET empty means "ephemeral
# process-local secret" (never allowed in APP_ENV=production).
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ISSUER=vctn-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_REFRESH_TOKEN_BYTES=32
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5

# -----------------------------------------------------------------------------
# Password policy
# -----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_SPECIAL_CHARACTERS=!@#$%^&*()-_=+[]{};:,.<>?/~
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRE_DAYS=90
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCK_MINUTES=30

# -----------------------------------------------------------------------------
# Rate limit (exact numbers are not frozen)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_API_PER_WINDOW=300
RATE_LIMIT_TOOL_GUEST_PER_WINDOW=30
RATE_LIMIT_TOOL_USER_PER_WINDOW=120
RATE_LIMIT_SENSITIVE_PER_WINDOW=20

# -----------------------------------------------------------------------------
# Redis key space and locking
# -----------------------------------------------------------------------------
REDIS_KEY_PREFIX=vctn
REDIS_LOCK_TTL_SECONDS=30
REDIS_LOCK_RETRY_INTERVAL_SECONDS=0.05
REDIS_LOCK_RETRY_TIMES=100

# -----------------------------------------------------------------------------
# Tool quota
# -----------------------------------------------------------------------------
TOOL_GUEST_DAILY_QUOTA=50
TOOL_USER_DAILY_QUOTA=500

# 未显式配置访问策略的工具的默认可见性：PUBLIC=所有人可用，REGISTERED=仅注册用户可用
TOOL_DEFAULT_VISIBILITY=PUBLIC

# -----------------------------------------------------------------------------
# Idempotency
# -----------------------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Outbox
# -----------------------------------------------------------------------------
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAY_SECONDS=60
OUTBOX_ENABLED=true

# -----------------------------------------------------------------------------
# Verification codes
# -----------------------------------------------------------------------------
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LENGTH=6

# -----------------------------------------------------------------------------
# Files / object storage
#
# local = objects below FILE_STORAGE_ROOT (single node only; with several
#         replicas each one sees a different disk).
# s3    = any S3 compatible endpoint. This is what you want in production:
#         switch FILE_STORAGE_PROVIDER to 's3' (or 'rustfs', which is the same
#         backend and reads better in a RustFS deployment) and fill in the
#         block below. 'minio' is still accepted for older configurations.
#         Secrets are read only from this file / the environment - never commit
#         the real values.
# -----------------------------------------------------------------------------
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_ROOT=storage
FILE_MAX_SIZE_BYTES=10485760
FILE_PRESIGN_TTL_SECONDS=900
FILE_DOWNLOAD_URL_TTL_SECONDS=3600
# Empty = built-in allow list of images and office documents. '*' = accept all.
FILE_ALLOWED_MIME_TYPES=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_SECURE=true
S3_REGION=us-east-1
S3_PREFIX=
S3_ADDRESSING_STYLE=path
S3_AUTO_CREATE_BUCKET=true
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# Exports
# -----------------------------------------------------------------------------
EXPORT_STORAGE_ROOT=exports
EXPORT_MAX_ROWS=100000
EXPORT_URL_TTL_SECONDS=3600
EXPORT_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Log retention (days) - frozen by the Spec
# -----------------------------------------------------------------------------
LOG_RETENTION_ACCESS_LOG_DAYS=30
LOG_RETENTION_SECURITY_LOG_DAYS=180
LOG_RETENTION_OPERATION_LOG_DAYS=180
LOG_RETENTION_AUDIT_LOG_DAYS=730
LOG_RETENTION_APPLICATION_LOG_DAYS=30

# -----------------------------------------------------------------------------
# Audit
# -----------------------------------------------------------------------------
AUDIT_ENABLED=true

# -----------------------------------------------------------------------------
# Monitoring data retention
# Applied by `python -m app.scripts.cleanup`, which a cron job should run daily.
# -----------------------------------------------------------------------------
OPS_RETENTION_SAMPLE_DAYS=7
OPS_RETENTION_HEARTBEAT_DAYS=7
OPS_RETENTION_HOURLY_DAYS=30
OPS_RETENTION_DAILY_DAYS=180
OPS_RETENTION_EVENT_DAYS=30
OPS_RETENTION_AVAILABILITY_DAYS=30
OPS_RETENTION_ALERT_HISTORY_DAYS=180
OPS_RETENTION_NOTIFICATION_DAYS=180
OPS_RETENTION_OPERATION_DAYS=180
OPS_PURGE_BATCH_SIZE=5000

# -----------------------------------------------------------------------------
# Ops scheduler (in-process periodic jobs)
# Off by default so that no replica surprises you by writing on its own; every
# job also takes a PostgreSQL advisory lock, so two replicas never overlap.
# -----------------------------------------------------------------------------
OPS_SCHEDULER_ENABLED=false
OPS_SCHEDULER_ALERT_INTERVAL_SECONDS=60
OPS_SCHEDULER_PROBE_INTERVAL_SECONDS=60
OPS_SCHEDULER_ROLLUP_INTERVAL_MINUTES=60
OPS_SCHEDULER_DAILY_ROLLUP_HOUR=0
OPS_SCHEDULER_PURGE_HOUR=4
OPS_SCHEDULER_LOCK_ID=8172543011

# -----------------------------------------------------------------------------
# Ops self monitoring (seeds an availability check against the API itself)
# -----------------------------------------------------------------------------
OPS_SELF_MONITOR_ENABLED=true
OPS_SELF_MONITOR_URL=http://127.0.0.1:8000/health

# -----------------------------------------------------------------------------
# HTTP / CORS
# The wildcard origin "*" is rejected by configuration validation.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=X-Trace-ID,X-Request-ID

# -----------------------------------------------------------------------------
# HTTP security headers
# Leave HSTS off until TLS terminates in front of the application: sending it
# over plain HTTP makes browsers refuse the origin for the whole max-age.
# A blank policy omits the header entirely - it never becomes permissive.
# In production ALLOWED_HOSTS and an enumerated CORS list are mandatory.
# -----------------------------------------------------------------------------
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_CSP=
SECURITY_CSP_REPORT_ONLY=false
SECURITY_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
# Comma separated host allow-list; empty accepts any Host header.
ALLOWED_HOSTS=
# Empty means "serve /docs outside production only".
DOCS_ENABLED=

# -----------------------------------------------------------------------------
# Tracing
# -----------------------------------------------------------------------------
TRACE_ID_HEADER=X-Trace-ID
REQUEST_ID_HEADER=X-Request-ID
TRACE_ID_MAX_LENGTH=128

# -----------------------------------------------------------------------------
# Logging
# LOG_LEVEL empty means "derive from APP_DEBUG" (DEBUG when true, else INFO).
# LOG_DATE_FORMAT empty means "use the logging module default".
# -----------------------------------------------------------------------------
LOG_LEVEL=
LOG_FORMAT=%(asctime)s %(levelname)-8s %(name)s [trace_id=%(trace_id)s] %(message)s
LOG_DATE_FORMAT=
# stdout | stderr
LOG_STREAM=stdout
